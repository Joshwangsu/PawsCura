{
  "expo": {
    "name": "PawsCura",
    "slug": "pawscura",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/app-logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pawscura.app",
      "config": {
        "googleMapsApiKey": "AIzaSyAgT-OYRquR2SpMJoKjWX0_IwP3bEoGzzU"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-logo.png",
        "backgroundColor": "#FCE5C8"
      },
      "package": "com.pawscura.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyAgT-OYRquR2SpMJoKjWX0_IwP3bEoGzzU"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/app-logo.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F1",
          "image": "./assets/splash-logo.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PawsCura needs your location to find veterinary clinics near you."
        }
      ],
      "expo-font",
      "expo-status-bar",
      "./plugins/withDisableMinify"
    ],
    "extra": {
      "eas": {
        "projectId": "9819972b-38f7-4732-81fe-067c97640e9f"
      }
    },
    "owner": "codejaowell"
  }
}
